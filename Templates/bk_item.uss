
:root {
	padding:0;
	margin:0;
	height:100%;
}

.sm-bookmarks__item {
	display: flex;
	flex-direction: row;
	height:100%;
}

.sm-bookmarks__item__icon {
	display: flex;
	width:15px;
	margin:2px;
	margin-left:4px;
	margin-right:4px;
}

.sm-bookmarks__item__label {
	padding:0;
	margin:0;
	-unity-text-align: middle-left;
	flex-grow:1;
	height:100%;
	font-size:11px;
	color:var(--unity-colors-default-text);
	
}