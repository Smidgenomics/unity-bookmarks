
:root {
	padding:0;
	margin:0;
	height:100%;
	--bk-item-font-size:12px;
	--bk-item-icon-size:15px;
}

.sm-bookmarks__item {
	display: flex;
	flex-direction: row;
	height:100%;
}

.sm-bookmarks__item__icon {
	display: flex;
	width:var(--bk-item-icon-size);
	margin:2px;
	flex-shrink: 0;
}

.sm-bookmarks__item__label {
	padding:0;
	margin:0;
	margin-left:3px;
	-unity-text-align: middle-left;
	flex-grow:1;
	height:100%;
	font-size:var(--bk-item-font-size);
	color:var(--unity-colors-default-text);
	text-overflow: ellipsis;
	flex-shrink: 1;
	overflow:hidden;
}

.sm-bookmarks__item__type-icon {
	display: flex;
	width:10px;
	margin:2px;
	opacity:1;
	flex-shrink:0;
}