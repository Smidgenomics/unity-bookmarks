
:root {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.flex-grow-1 {
	flex-grow:1;
}

.flex-grow-0 {
	flex-grow:0;
}

.sm-bookmarks__window {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.sm-bookmarks__toolbar {
	display: flex;
	flex-grow: 0;
	flex-direction: row;
}

.sm-bookmarks__footer {
	display: flex;
	flex-grow: 0;
	padding:2px;
	overflow: hidden;
}

.sm-bookmarks__content {
	flex-grow: 1;
}

.sm-bookmarks__flex {
	margin: auto;
}

.sm-bookmarks__footer__path {
	-unity-text-align: middle-left;
	color:var(--unity-colors-default-text);
	font-size:8px;
	flex-shrink:1;
	overflow:hidden;
	text-overflow: ellipsis;
	text-shadow: #0008 1px 0 10px;
	margin-right:3px;
}

.sm-bookmarks__footer__size {
	-unity-text-align: middle-right;
	color:var(--unity-colors-default-text);
	font-size:9px;
	-unity-font-style: bold;
	width:25px;
	flex-shrink:1;
}

.unity-toolbar-search-field {
	flex-grow: 1;
	min-width: 0;
	flex-shrink: 1;
}

.sm-bookmarks__toolbar__menu {
	min-width:35px;
	width:35px;
}

.sm-bookmarks__toolbar__menu .unity-image {
	aspect-ratio:1;
	width:15px;
	opacity: 0.5;
}

.sm-bookmarks__toolbar__button {
	width:29px;
	flex-shrink:0;
}

.sm-bookmarks__toolbar__button .unity-image {
	aspect-ratio:1;
	width:15px;
	min-width:15px;
	height:100%;
	opacity: 0.5;
}