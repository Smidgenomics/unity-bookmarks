<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.smidgenomics.unity-bookmarks/Templates/bk_item.uss?fileID=7433441132597879392&amp;guid=b21ee87d690fcb648a3fa4ac3efb1c8d&amp;type=3#bk_item"/>
    <ui:VisualElement name="Item" data-source-type="Smidgenomics.Unity.Bookmarks.Editor.BKItemViewData, Smidgenomics.Unity.Bookmarks.Editor" class="sm-bookmarks__item">
        <ui:Image source="project://database/Packages/com.smidgenomics.unity-bookmarks/Assets/%7Bsm_bk%7D.png?fileID=2800000&amp;guid=cd57f4841c2dfd44d817b21efe0189f4&amp;type=3#{sm_bk}" name="Image" uv="0,0,0.25,0.25" class="sm-bookmarks__item__icon">
            <Bindings>
                <ui:DataBinding property="source" data-source-path="icon" binding-mode="ToTarget"/>
                <ui:DataBinding property="uv" data-source-path="uv" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Image>
        <ui:Label text="-" name="Label" class="sm-bookmarks__item__label">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="label" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <Bindings>
            <ui:DataBinding property="style.backgroundColor" data-source-path="BGColor" binding-mode="ToTarget"/>
        </Bindings>
    </ui:VisualElement>
</ui:UXML>
